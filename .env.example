# Copie para .env e preencha. NUNCA versione o .env.
# Gere segredos com: openssl rand -hex 24   (use só [a-z0-9]: as senhas entram em URLs)

# ---------------------------------------------------------------- Discord
# Portal: https://discord.com/developers/applications → sua aplicação → Bot → Reset Token
DISCORD_TOKEN=
# Application ID (General Information)
DISCORD_CLIENT_ID=
# Opcional: servidor de testes; `pnpm deploy-commands` registra só nele (efeito imediato)
DISCORD_DEV_GUILD_ID=

# ---------------------------------------------------------------- Identidade visual
BOT_NAME=Aurora
BOT_ACCENT_COLOR=#7C5CFF

# ---------------------------------------------------------------- Docker Compose (VPS)
# Usados pelo docker-compose.yml para montar DATABASE_URL, REDIS_URL e LAVALINK_NODES do bot.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
LAVALINK_PASSWORD=
# Memória máxima da JVM do Lavalink (512 MB atende ~dezenas de players simultâneos)
LAVALINK_JAVA_OPTS=-Xmx512m
# Só para o docker-compose.monitoring.yml
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Desenvolvimento local (fora do Compose)
# No Compose estes três são definidos automaticamente e os valores abaixo são ignorados.
# Com docker-compose.dev.yml: usuário aurora, senha = POSTGRES_PASSWORD, banco aurora.
DATABASE_URL=postgresql://aurora:troque-pela-POSTGRES_PASSWORD@127.0.0.1:5432/aurora
# Opcional. Sem Redis, rate limit e leases ficam em memória (válido para uma única instância).
REDIS_URL=
# id|host|porta|senha|tls  (vários nós separados por vírgula)
# Com docker-compose.dev.yml: senha = LAVALINK_PASSWORD.
LAVALINK_NODES=main|127.0.0.1|2333|troque-pela-LAVALINK_PASSWORD|false

# ---------------------------------------------------------------- Observabilidade
LOG_LEVEL=info
LOG_PRETTY=false
HTTP_HOST=0.0.0.0
HTTP_PORT=9464
# Mínimo 24 caracteres. Sem ele o endpoint /metrics fica desativado.
METRICS_TOKEN=

# ---------------------------------------------------------------- Limites e retenção
DATABASE_POOL_MAX=10
MAX_QUEUE_SIZE=1000
MAX_PLAYLISTS_PER_USER=25
MAX_PLAYLIST_TRACKS=500
PANEL_UPDATE_INTERVAL_MS=15000
HISTORY_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=180
